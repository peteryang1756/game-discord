[Unit]
Description=Werewolf Telegram Controller v21
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exedev
WorkingDirectory=/home/exedev/werewolf-tg
EnvironmentFile=/etc/werewolf-v21.env
ExecStart=/usr/bin/python3 /home/exedev/werewolf-tg/werewolf_agents_v21.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
